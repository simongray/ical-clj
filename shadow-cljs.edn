{:deps   {:aliases [:cljs]}
 :builds {;; clojure -M:cljs compile test
          :test         {:target    :node-test
                         :output-to "target/node-tests.js"
                         :ns-regexp "-test$"
                         :autorun   true}
          ;; clojure -M:cljs compile browser-test, then serve
          ;; target/browser-test (without the tests that read the files of
          ;; dev-resources, which a browser can't)
          :browser-test {:target    :browser-test
                         :test-dir  "target/browser-test"
                         :ns-regexp "^dk\\.simongray\\.ical(?!\\.(corpus|libical)-test).*-test$"}}}
